+	raw_x = get_unaligned_be16(&info->abs_x);
+	*event_flag = (raw_x >> 14) & 0x03;
+
+	info->abs_x = raw_x & GENMASK(11, 0);
 	info->abs_y = get_unaligned_be16(&info->abs_y) & GENMASK(11, 0);
 
