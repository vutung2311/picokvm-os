+			input_set_capability(priv->input, EV_KEY,
+					     priv->event_map[i].code);
+	}
 
 	input_set_abs_params(priv->input, ABS_X, 0, 240, 0, 0);
 	input_set_abs_params(priv->input, ABS_Y, 0, 240, 0, 0);
@@ -140,23 +150,27 @@ static irqreturn_t cst816x_irq_cb(int irq, void *cookie)
 {
 	struct cst816x_priv *priv = cookie;
 	struct cst816x_touch_info info;
+	u8 event_flag = 0;
+	bool is_down;
 
-	if (!cst816x_process_touch(priv, &info))
+	if (!cst816x_process_touch(priv, &info, &event_flag))
 		return IRQ_HANDLED;
 
-	if (info.touch) {
+	/* event_flag 0x01 = Touch Up / release. info.touch == 0 = no finger. */
+	is_down = (info.touch > 0) && (event_flag != 1);
+
+	if (is_down) {
 		input_report_abs(priv->input, ABS_X, info.abs_x);
