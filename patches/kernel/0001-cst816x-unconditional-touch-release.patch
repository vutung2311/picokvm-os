--- a/drivers/input/touchscreen/hynitron-cst816x.c
+++ b/drivers/input/touchscreen/hynitron-cst816x.c
@@ -92,16 +92,22 @@ static int cst816x_i2c_read_register(struct cst816x_priv *priv, u8 reg,
 }
 
 static bool cst816x_process_touch(struct cst816x_priv *priv,
-				  struct cst816x_touch_info *info)
+				  struct cst816x_touch_info *info,
+				  u8 *event_flag)
 {
+	u16 raw_x;
+
 	if (cst816x_i2c_read_register(priv, CST816X_FRAME, info, sizeof(*info)))
 		return false;
 
