-
-		if (!info.touch)
-			input_report_key(priv->input, BTN_TOUCH, 0);
+		u16 code = priv->event_map[info.gesture & 0x0F].code;
+		if (code)
+			input_report_key(priv->input, code, is_down);
 	}
 
 	input_sync(priv->input);
